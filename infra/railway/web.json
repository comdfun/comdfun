{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/docker/web.Dockerfile",
    "watchPatterns": [
      "apps/web/**",
      "packages/art/**",
      "packages/abi/**",
      "packages/protocol/**",
      "infra/docker/web.Dockerfile",
      "package.json",
      "package-lock.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
