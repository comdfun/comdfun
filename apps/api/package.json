{
  "name": "@company/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chambers: Company.md control plane (HTTP + WS /agent + scheduler + attester + settler).",
  "engines": {
    "node": ">=22.18"
  },
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@company/abi": "*",
    "@company/art": "*",
    "@company/protocol": "*",
    "@company/services": "*",
    "pg": "^8.13.0",
    "viem": "^2.57.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@company/worker": "*",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
