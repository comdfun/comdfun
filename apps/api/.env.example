# Chambers — Company.md control plane (apps/api). Copy to .env; every variable is optional unless marked.
# GET /health works with none of these set and lists what is degraded.

# --- process -----------------------------------------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
NODE_ENV=production
# behind Railway/any proxy: trust X-Forwarded-For for per-IP rate limits (default true)
TRUST_PROXY=true

# --- chain: Robinhood Chain MAINNET 4663 by default (testnet: CHAIN_ID=46630 + its RPC) -----------------------------
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# extra chains for oracle questions / launches: RPC_URL_<chainId>
# RPC_URL_46630=https://rpc.testnet.chain.robinhood.com
# chains offered to launch.open / workflow.open (first is the default; default CHAIN_ID)
LAUNCH_CHAINS=4663

# --- public URLs ---------------------------------------------------------------------------------------------
# production defaults (NODE_ENV=production) are https://api.comd.fun, https://comd.fun, sites.comd.fun; dev: localhost
PUBLIC_API_URL=https://api.comd.fun
PUBLIC_WEB_URL=https://comd.fun
# hosted sites are served by this API at https://<label>.<SITES_DOMAIN> (wildcard custom domain on Railway)
SITES_DOMAIN=sites.comd.fun
# browser origins allowed on paid routes (default PUBLIC_WEB_URL); others get 403 origin_not_allowed
ALLOWED_ORIGINS=https://comd.fun
# shown in /version, /health and the HTML pages
CONTACT_EMAIL=team@comd.fun

# --- database (Postgres; unset = in-memory, nothing survives a restart) ----------------------------------------
DATABASE_URL=postgresql://user:pass@host:5432/company

# --- storage (bundles, artifacts, hosted sites) -------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_DIR=/data/storage
# STORAGE_DRIVER=s3 (Railway Bucket, Cloudflare R2, MinIO, AWS)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_URL=

# --- keys (never commit) ------------------------------------------------------------------------------------------
# signs EIP-712 OracleAttestation (domain {name "Company.md Oracle", version "1", chainId}, no verifyingContract —
# exactly OracleAttestationVerifier.sol); consumers trust this address; unset = ephemeral key per process (degraded)
ATTESTER_PRIVATE_KEY=
# the settler: Permit2 spender for x402 payments (pays gas; named in 402 accepts[0].extra.spender), sends
# ReputationRegistry.giveFeedback batches and RewardDistributor.postRoot (needs SETTLER_ROLE). Must NOT own or
# operate any agent (ERC-8004 refuses self-feedback). Its transactions are serialised (one nonce stream).
SETTLER_PRIVATE_KEY=
# the Registrar: forge script --broadcast through ProjectFactory (needs REGISTRAR_ROLE); a separate key from the settler
DEPLOYER_PRIVATE_KEY=
# forge for the Clerk and the Registrar (default: forge on PATH); solc for the Registrar's launch template
# (the Docker image sets FORGE_BIN and SOLC_BIN=/root/.svm/0.8.26/solc-0.8.26; LAUNCH_SOLC overrides)
FORGE_BIN=
LAUNCH_SOLC=
# Clerk sandboxes: "env" when the host refuses unprivileged user namespaces (Railway)
SANDBOX_NET=env
# Records Office: GitHub org for filings (repos / PRs); unset token = dry-run publication
GITHUB_TOKEN=
GITHUB_ORG=comd-filings

# the keeper (ETH for gas; must be Flywheel.keeper() for buybacks — owner calls Flywheel.setKeeper(address)).
# Each tick, in order (every call simulated first, per-task spacing):
#   ComdTaxHook.flush()        when tax / trim proceeds are held as claims (pendingTax, claimEth, claimComd > 0)
#   BuyWall.rebalance()        when canRebalance(); KEEPER_REQUIRE_PROFIT=true skips it while the simulated tip < gas cost
#   RewardDripper.drip()       when pending() > 0, at least hourly (KEEPER_DRIP_EVERY_SECONDS is capped at 3600)
#   Flywheel.buyback(minOut)   when the buyback bucket ≥ KEEPER_BUYBACK_MIN_WEI (minOut = simulated output − slippage; burned)
#   RevenueRouter.distribute() when it holds ≥ KEEPER_DISTRIBUTE_MIN_COMD (80% Counsel rewards / 20% firm treasury)
# Floor sweeps are manual (GET /flywheel/sweep-candidates).
# Unset = off (GET /health reports keeper_off). Intervals in seconds; ETH in wei; COMD in atomic units (18 dec).
KEEPER_PRIVATE_KEY=
KEEPER_INTERVAL_SECONDS=60
KEEPER_FLUSH_EVERY_SECONDS=600
KEEPER_REBALANCE_EVERY_SECONDS=300
KEEPER_REQUIRE_PROFIT=true
KEEPER_DRIP_EVERY_SECONDS=1800
KEEPER_BUYBACK_MIN_WEI=50000000000000000
KEEPER_BUYBACK_EVERY_SECONDS=900
KEEPER_BUYBACK_SLIPPAGE_BPS=300
KEEPER_DISTRIBUTE_MIN_COMD=1000000000000000000000
KEEPER_DISTRIBUTE_EVERY_SECONDS=3600
KEEPER_MIN_ETH_WEI=1000000000000000

# --- flywheel (GET /flywheel, GET /flywheel/sweep-candidates) -------------------------------------------------------
# a JSON endpoint listing Company.md Counsel for sale: {"listings":[{"tokenId","price" (wei),"marketplace","adapter","data",
# "expiresAt","url"}]} (your indexer or a marketplace API proxy); unset = sweep-candidates returns []
SWEEP_LISTINGS_URL=
FLYWHEEL_CACHE_SECONDS=15
FLYWHEEL_EVENT_BLOCKS=50000

# --- payments (x402 v2, scheme exact, Permit2, asset $COMD 18 decimals) --------------------------------------------
# payTo; default = REVENUE_ROUTER (COMD received: 80% to the RewardDistributor / 20% to the firm treasury on distribute())
PAYTO_ADDRESS=
# the payment asset is COMD_TOKEN (contracts section)
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
# price per action in COMD atomic units (default 100 COMD); schedules are priced per run
PRICE_COMD=100000000000000000000
# all seven by default: job.open,job.continue,launch.open,workflow.open,oracle.request,schedule.create,schedule.topup
ENABLED_ACTIONS=
# without SETTLER_PRIVATE_KEY+RPC_URL: "mock" accepts signed payments without moving funds (dev only); default off in production
PAYMENTS_MODE=off
# how long a paid submit waits for settlement before answering 202 (poll GET /requests/:id)
SETTLE_WAIT_MS=25000
REQUESTS_PER_MINUTE=300
QUOTES_PER_MINUTE=30
READS_PER_MINUTE=120

# --- contracts ------------------------------------------------------------------------------------------------------
# Each address resolves from its env var, else DEPLOYMENTS_FILE (contracts/deployments/<chainId>.json from
# Deploy.s.sol), else the @company/abi address book for CHAIN_ID when that chain is marked deployed.
DEPLOYMENTS_FILE=
COUNSEL_NFT=
COMD_TOKEN=
IDENTITY_REGISTRY=
REPUTATION_REGISTRY=
PROJECT_FACTORY=
REWARD_DISTRIBUTOR=
CONTRIBUTOR_DISTRIBUTOR=
REVENUE_ROUTER=
# flywheel, the COMD/ETH pool and its buy wall, staking and bond (else DEPLOYMENTS_FILE keys flywheel, comdRouter,
# comdTaxHook, buyWall, stakedComd, rewardDripper, bond)
FLYWHEEL=
COMD_ROUTER=
COMD_TAX_HOOK=
BUY_WALL=
STAKED_COMD=
REWARD_DRIPPER=
BOND=
# launch policy owners (token, treasury, hook admin, LP position); default PAYTO_ADDRESS
TREASURY_ADDRESS=
MAX_SUPPLY=2000

# --- Managing Partner (planning) -------------------------------------------------------------------------------------
# the LLM is used only where IMD uses workflow-planner (the front-end half of a workflow); everything else is deterministic
ORCHESTRATOR_RUNTIME=anthropic-api
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- dispatch & seats ----------------------------------------------------------------------------------------------------
# seats must be registered ERC-8004 agents to connect (IMD behaviour)
REQUIRE_REGISTRATION=true
# premium work (contracts: Foundry implement/tests/integrate skills; front ends and websites) routes only to seats on a
# top-tier model AT HIGH EFFORT (effort high|xhigh|max). Regex of top-tier model ids; default: claude-opus-5-5 / claude-fable-5-1 / gpt-6-astra class (opus, fable, gpt-6, gpt-5.x-codex)
PREMIUM_MODELS=
# heartbeat interval announced to workers; a seat silent for 3 intervals is disconnected
HEARTBEAT_MS=15000
# multiply lease timeouts (tests use tiny values)
LEASE_SCALE=1
# skills catalog: index.json + <id>/SKILL.md (default: <repo>/skills); /health reports skills_builtin if missing
SKILLS_DIR=
# test only (ignored when NODE_ENV=production): seconds between schedule runs instead of 10/30 minutes
SCHEDULE_MIN_INTERVAL_SECONDS=
# force the deterministic mock services (tests/demos); default: the real @company/services
SERVICES_MODE=

# --- seat rewards (RewardDistributor) ------------------------------------------------------------------------------------
# seat rewards are COMD only. Epochs from this date (7 days each). At close the pool is the COMD the RewardDistributor
# holds unallocated (80% of job revenue via RevenueRouter.distribute() + 4.5% of hook trims), split by accepted work,
# posted with postRoot(epoch, COMD, root, total). Epochs with work but no funds wait and post when funds arrive.
REWARD_GENESIS=2026-10-05T00:00:00Z
# optional per-epoch cap (COMD atomic units)
REWARD_EPOCH_COMD_POOL=
# test only (ignored in production): epoch length in seconds
REWARD_EPOCH_SECONDS=

# --- admin -----------------------------------------------------------------------------------------------------------------
# Bearer for POST /launches/:id/assurances and POST /admin/settle (run the settler now)
ADMIN_TOKEN=
GIT_COMMIT=
